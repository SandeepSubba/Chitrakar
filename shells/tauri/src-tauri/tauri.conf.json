{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chitrakar",
  "version": "0.1.0",
  "identifier": "com.chitrakar.app",
  "build": {
    "beforeDevCommand": "npm --prefix ../../app run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../../app run build",
    "frontendDist": "../../../app/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Chitrakar",
        "label": "main",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "Non-destructive photo and vector editor",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
