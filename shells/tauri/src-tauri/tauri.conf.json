{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chitrakar",
  "version": "0.1.0",
  "identifier": "com.chitrakar.app",
  "build": {
    "beforeDevCommand": "npm --prefix ../../app run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../../app run build",
    "frontendDist": "../../../app/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Chitrakar",
        "label": "main",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": []
  }
}
